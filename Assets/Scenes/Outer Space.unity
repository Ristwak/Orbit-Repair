  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Suit Up VR is an interactive virtual reality experience that teaches players
    how astronauts prepare for space missions. Set inside a detailed spacecraft environment,
    the game guides you step by step through the process of wearing a real space
    suit. From the cooling garment to the main suit, gloves, helmet, and life support
    backpack, each stage is fully interactive and supported by visual and audio feedback.


    Players
    will learn the purpose of each component, practice assembling the suit in the
    correct sequence, and then experience a short zero gravity challenge to understand
    why every step is critical. Quizzes and reflections reinforce key concepts, while
    completion rewards celebrate progress. Suit Up VR combines education and immersion
    to help students gain a deeper appreciation for astronaut training and space
    exploration.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
